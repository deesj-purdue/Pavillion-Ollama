# Optional overrides — copy to .env and edit as needed

# Port the web UI listens on (host-side)
WEB_PORT=5000

# Default model to pre-select in the UI
# Run: docker exec pavillion-ollama ollama pull llama3.2
DEFAULT_MODEL=llama3.2

# System prompt prepended to every conversation.
# The default instructs the model to keep replies short — useful on low-powered hardware.
# Set to an empty string to disable: SYSTEM_PROMPT=
SYSTEM_PROMPT=You are a helpful assistant. Keep your answers short and concise. Avoid unnecessary elaboration.
